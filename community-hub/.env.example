# PostgreSQL connection string. Use a managed PostgreSQL provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Comma-separated allowed frontend origins, e.g. https://your-hub.vercel.app
CORS_ORIGIN="http://localhost:5173"

# InterLink identity verification is disabled until official integration details are supplied.
# Configure all three values only after InterLink confirms the values for your App ID.
INTERLINK_JWKS_URL=""
INTERLINK_ISSUER=""
INTERLINK_AUDIENCE=""

# Admin API protection. Generate a long random secret and keep it only in Vercel Environment Variables.
ADMIN_API_TOKEN=""

# Local development only. Never enable in production.
DEV_AUTH_ENABLED="false"
